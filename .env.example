# API_URL ใช้สำหรับ Next.js ฝั่ง Server-side ต่อตรงไปที่หลังบ้านผ่าน localhost (ไม่ต้องผ่าน HTTPS/SSL)
API_URL=""

# NEXT_PUBLIC_API_URL ใช้สำหรับ Client-side (เบราว์เซอร์ของคนทั่วไป)
NEXT_PUBLIC_API_URL=""
API_TOKEN=""

# --- Auth.js Secret ---
# ใช้สำหรับเข้ารหัส Session (ห้ามเปลี่ยนไปมา ไม่งั้น User หลุด)
AUTH_SECRET=""

# --- ThaID Sandbox Configuration (CORRECTED URL) ---
# ต้องแก้
THAID_ISSUER=""

# Auth URL
# ต้องแก้
NEXT_PUBLIC_THAID_AUTH_URL=""

# Token & UserInfo (Service)
# ต้องแก้
THAID_TOKEN_URL=""
THAID_USERINFO_URL=""

# Credentials (Sandbox)
# ต้องแก้
NEXT_PUBLIC_THAID_CLIENT_ID=""
THAID_CLIENT_SECRET=""
THAID_BASIC_TOKEN=""
THAID_API_KEY=""


# # API For Employee Checking
# EMPLOYEE_API_URL=""
# EMPLOYEE_API_KEY=""
AUTH_URL=""
AUTH_TRUST_HOST=true
NEXT_PUBLIC_APP_URL=""

# เพิ่มตัวนี้ถ้าใช้ Auth.js เพื่อความชัวร์
TRUST_AUTH_PROXY=true

# NODE_TLS_REJECT_UNAUTHORIZED=0 # ปิดไว้บน Production เพื่อความปลอดภัย (ป้องกัน MitM)
